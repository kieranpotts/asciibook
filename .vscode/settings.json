{
  /* Vertical guidelines for line wrapping. */
  "editor.rulers": [
    80,
    100,
    120,
  ],

  /* By default, wrap long lines at the viewport or 120 characters, whichever is narrowest. */
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,

  /* Show control and empty space characters. */
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "all",

  /* Enforce 2 spaces for indentation by default. */
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 2,

  /* Disable auto-formatting by default. */
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.formatOnType": false,

  /* Disable auto-fixes by default. */
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  },

  /* Language-specific overrides. */
  "[asciidoc]": {
    "editor.rulers": [100],
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
  },
  "[markdown]": {
    "editor.rulers": [100],
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
  },

  /* Always prompt before committing to a protected branch. */
  "git.branchProtectionPrompt": "alwaysPrompt",
  "git.branchProtection": [
    // "stable",
    // "release/*",
  ],

  /*
  EXTENSION SETTINGS
  The following settings are applicable for the extensions listed in
  the extension recommendations in `extensions.json`.
  */

  /*
  Asciidoc extension.
  https://marketplace.visualstudio.com/items?itemName=asciidoctor.asciidoctor-vscode
  */

  /* Enable Antora support. */
  "asciidoc.antora.showEnableAntoraPrompt": false,

  /* When previewing Asciidoc files in VS Code, don't apply VS Code's workbench
  color theme to the generated HTML... */
  "asciidoc.preview.useEditorStyle": false,

  /* ...Instead use the asciidoctors default CSS, which has been copied from
  the following URL. This means the preview will be fairly consistent with the
  generated HTML from the Asciidoctor CLI.
  https://github.com/asciidoctor/asciidoctor/blob/main/src/stylesheets/asciidoctor.css */
  "asciidoc.preview.style": "./.vscode/_/asciidoctor.css",
}
